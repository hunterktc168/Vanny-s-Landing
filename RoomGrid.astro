---
import { rooms } from '@data/site';
---
<section id="rooms" class="mx-auto max-w-5xl px-4 py-12">
  <h2 class="text-2xl font-bold tracking-tight text-slate-900">Rooms</h2>
  <p class="mt-2 max-w-2xl text-base text-slate-600">Three double-room categories. Exact rates are available by direct message — we match public OTA pricing for the same dates.</p>
  <ul class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {rooms.map((room) => (
      <li class="overflow-hidden rounded-xl border border-slate-200 bg-white">
        <div class="aspect-[4/3] bg-slate-200"><img src={room.image} alt={room.imageAlt} width="600" height="450" class="h-full w-full object-cover" loading="lazy" decoding="async" /></div>
        <div class="p-4">
          <h3 class="text-lg font-semibold text-slate-900">{room.name}</h3>
          <p class="mt-1 text-sm text-slate-600">{room.bed} · {room.bathroom}</p>
          <ul class="mt-3 flex flex-wrap gap-1.5 text-xs">{room.features.map((feature) => <li class="rounded-full bg-slate-100 px-2.5 py-1 text-slate-700">{feature}</li>)}</ul>
        </div>
      </li>
    ))}
  </ul>
</section>
