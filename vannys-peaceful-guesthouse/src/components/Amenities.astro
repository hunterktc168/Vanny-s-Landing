---
import { amenities } from '@data/site';
---
<section class="bg-slate-50">
  <div class="mx-auto max-w-5xl px-4 py-12">
    <h2 class="text-2xl font-bold tracking-tight text-slate-900">Amenities</h2>
    <ul class="mt-6 grid grid-cols-1 gap-x-8 gap-y-3 sm:grid-cols-2 lg:grid-cols-3">
      {amenities.map((item) => <li class="flex items-start gap-2 text-base text-slate-700"><span aria-hidden="true" class="mt-0.5 text-emerald-700">✓</span>{item}</li>)}
    </ul>
  </div>
</section>
